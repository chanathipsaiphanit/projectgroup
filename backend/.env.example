# Add these to your existing backend .env
JWT_SECRET=change-me-to-a-long-random-string

# Optional — lets Claude write the AI advisor / compare summaries.
# Without it the app still works with rule-based summaries.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Language for AI summaries, e.g. English or Thai
AI_LANGUAGE=English
